      <title>VScode-Opencv-Python</title>
      <link href="/post/1eb2b536.html"/>
      <url>/post/1eb2b536.html</url>
      
        <content type="html"><![CDATA[<div class="note info flat"><p>初学者Tips：<code>记录自己Opencv学习过程</code></p></div><h1 id="图像处理的基本操作"><a href="#图像处理的基本操作" class="headerlink" title="图像处理的基本操作"></a>图像处理的基本操作</h1><figure class="highlight python"><table><tr><td class="gutter"><pre><span class="line">1</span><br><span class="line">2</span><br><span class="line">3</span><br><span class="line">4</span><br><span class="line">5</span><br><span class="line">6</span><br><span class="line">7</span><br><span class="line">8</span><br><span class="line">9</span><br><span class="line">10</span><br><span class="line">11</span><br><span class="line">12</span><br><span class="line">13</span><br><span class="line">14</span><br><span class="line">15</span><br><span class="line">16</span><br><span class="line">17</span><br><span class="line">18</span><br><span class="line">19</span><br><span class="line">20</span><br><span class="line">21</span><br></pre></td><td class="code"><pre><span class="line"><span class="comment"># import numpy as np</span></span><br><span class="line"><span class="keyword">import</span> cv2</span><br><span class="line">img = cv2.imread(<span class="string">&#x27;img\Oucer-Jinsheng.jpg&#x27;</span>,<span class="number">1</span>)</span><br><span class="line"><span class="comment"># cv2.namedWindow(&#x27;img&#x27;,cv2.WINDOW_AUTOSIZE)</span></span><br><span class="line"><span class="comment"># print(img)</span></span><br><span class="line"></span><br><span class="line"><span class="comment"># cv2.destroyAllWindows()</span></span><br><span class="line"></span><br><span class="line"><span class="built_in">print</span>(<span class="string">&quot;获取彩色图像的属性：&quot;</span>)</span><br><span class="line"><span class="built_in">print</span>(<span class="string">&quot;shape=&quot;</span>,img.shape)</span><br><span class="line"><span class="built_in">print</span>(<span class="string">&quot;size=&quot;</span>,img.size)</span><br><span class="line"><span class="built_in">print</span>(<span class="string">&quot;dtype=&quot;</span>,img.dtype)</span><br><span class="line"></span><br><span class="line">img_gray = cv2.imread(<span class="string">&#x27;img\Oucer-Jinsheng.jpg&#x27;</span>,<span class="number">0</span>)</span><br><span class="line"><span class="built_in">print</span>(<span class="string">&quot;获取灰色图像的属性：&quot;</span>)</span><br><span class="line"><span class="built_in">print</span>(<span class="string">&quot;shape=&quot;</span>,img_gray.shape)</span><br><span class="line"><span class="built_in">print</span>(<span class="string">&quot;size=&quot;</span>,img_gray.size)</span><br><span class="line"><span class="built_in">print</span>(<span class="string">&quot;dtype=&quot;</span>,img_gray.dtype)</span><br><span class="line"></span><br><span class="line">cv2.imshow(<span class="string">&#x27;photo_person&#x27;</span>,img)</span><br><span class="line">cv2.waitKey()</span><br></pre></td></tr></table></figure><h1 id="像素"><a href="#像素" class="headerlink" title="像素"></a>像素</h1><figure class="highlight python"><table><tr><td class="gutter"><pre><span class="line">1</span><br><span class="line">2</span><br><span class="line">3</span><br><span class="line">4</span><br><span class="line">5</span><br><span class="line">6</span><br><span class="line">7</span><br><span class="line">8</span><br><span class="line">9</span><br><span class="line">10</span><br><span class="line">11</span><br><span class="line">12</span><br><span class="line">13</span><br><span class="line">14</span><br><span class="line">15</span><br><span class="line">16</span><br><span class="line">17</span><br></pre></td><td class="code"><pre><span class="line"><span class="keyword">import</span> cv2</span><br><span class="line">img = cv2.imread(<span class="string">&#x27;img\Oucer-Jinsheng.jpg&#x27;</span>,<span class="number">1</span>)    <span class="comment">#读取图像</span></span><br><span class="line">px = img[<span class="number">29</span>,<span class="number">20</span>]   <span class="comment">#读取（29，20）上的像素</span></span><br><span class="line"><span class="built_in">print</span>(<span class="string">&quot;坐标上的像素BGR是&quot;</span>,px)</span><br><span class="line"></span><br><span class="line">blue = img[<span class="number">29</span>,<span class="number">20</span>,<span class="number">0</span>]     <span class="comment">#坐标上像素值B通道的值</span></span><br><span class="line">green = img[<span class="number">29</span>,<span class="number">20</span>,<span class="number">1</span>]     <span class="comment">#坐标上像素值G通道的值</span></span><br><span class="line">red = img[<span class="number">29</span>,<span class="number">20</span>,<span class="number">2</span>]     <span class="comment">#坐标上像素值R通道的值</span></span><br><span class="line"><span class="built_in">print</span>(blue,green,red)</span><br><span class="line"></span><br><span class="line">cv2.imshow(<span class="string">&quot;Person_Photo&quot;</span>,img)</span><br><span class="line"><span class="keyword">for</span> i <span class="keyword">in</span> <span class="built_in">range</span>(<span class="number">1</span>,<span class="number">20</span>):</span><br><span class="line">    <span class="keyword">for</span> j <span class="keyword">in</span> <span class="built_in">range</span>(<span class="number">1</span>,<span class="number">20</span>):</span><br><span class="line">        img[i,j]=[<span class="number">255</span>,<span class="number">255</span>,<span class="number">255</span>]</span><br><span class="line">cv2.imshow(<span class="string">&quot;Person_Photo_after&quot;</span>,img)</span><br><span class="line">cv2.waitKey()</span><br><span class="line">cv2.destroyAllWindows  </span><br></pre></td></tr></table></figure><h1 id="色彩空间"><a href="#色彩空间" class="headerlink" title="色彩空间"></a>色彩空间</h1><figure class="highlight python"><table><tr><td class="gutter"><pre><span class="line">1</span><br><span class="line">2</span><br><span class="line">3</span><br><span class="line">4</span><br><span class="line">5</span><br><span class="line">6</span><br><span class="line">7</span><br><span class="line">8</span><br><span class="line">9</span><br><span class="line">10</span><br></pre></td><td class="code"><pre><span class="line"><span class="comment">#从BGR色彩空间转换到GRAY色彩空间，cv2.COLOR_BGR2GRAY</span></span><br><span class="line"></span><br><span class="line"><span class="keyword">import</span> cv2</span><br><span class="line">img = cv2.imread(<span class="string">&#x27;img\Oucer-Jinsheng.jpg&#x27;</span>,<span class="number">1</span>)</span><br><span class="line">cv2.imshow(<span class="string">&quot;Person_Photo&quot;</span>,img)</span><br><span class="line"></span><br><span class="line">gray_img = cv2.cvtColor(img,cv2.COLOR_BGR2GRAY)</span><br><span class="line">cv2.imshow(<span class="string">&quot;Person_Photo_after&quot;</span>,gray_img)</span><br><span class="line">cv2.waitKey()</span><br><span class="line">cv2.destroyAllWindows</span><br></pre></td></tr></table></figure><h1 id="HSV色彩空间"><a href="#HSV色彩空间" class="headerlink" title="HSV色彩空间"></a>HSV色彩空间</h1><figure class="highlight python"><table><tr><td class="gutter"><pre><span class="line">1</span><br><span class="line">2</span><br><span class="line">3</span><br><span class="line">4</span><br><span class="line">5</span><br><span class="line">6</span><br><span class="line">7</span><br><span class="line">8</span><br><span class="line">9</span><br></pre></td><td class="code"><pre><span class="line"><span class="comment">#HSV基于色调、饱和度、亮度,Opencv色调在[0,180]取值</span></span><br><span class="line"><span class="keyword">import</span> cv2</span><br><span class="line">img = cv2.imread(<span class="string">&#x27;img\Oucer-Jinsheng.jpg&#x27;</span>,<span class="number">1</span>)</span><br><span class="line">cv2.imshow(<span class="string">&quot;Person_Photo&quot;</span>,img)</span><br><span class="line"></span><br><span class="line">HSV_img = cv2.cvtColor(img,cv2.COLOR_BGR2HSV)</span><br><span class="line">cv2.imshow(<span class="string">&quot;Person_Photo_after&quot;</span>,HSV_img)</span><br><span class="line">cv2.waitKey()</span><br><span class="line">cv2.destroyAllWindows </span><br></pre></td></tr></table></figure><h1 id="通道"><a href="#通道" class="headerlink" title="通道"></a>通道</h1><figure class="highlight python"><table><tr><td class="gutter"><pre><span class="line">1</span><br><span class="line">2</span><br><span class="line">3</span><br><span class="line">4</span><br><span class="line">5</span><br><span class="line">6</span><br><span class="line">7</span><br><span class="line">8</span><br><span class="line">9</span><br><span class="line">10</span><br><span class="line">11</span><br><span class="line">12</span><br><span class="line">13</span><br><span class="line">14</span><br><span class="line">15</span><br><span class="line">16</span><br><span class="line">17</span><br><span class="line">18</span><br><span class="line">19</span><br><span class="line">20</span><br><span class="line">21</span><br><span class="line">22</span><br><span class="line">23</span><br><span class="line">24</span><br><span class="line">25</span><br><span class="line">26</span><br><span class="line">27</span><br><span class="line">28</span><br><span class="line">29</span><br><span class="line">30</span><br><span class="line">31</span><br><span class="line">32</span><br></pre></td><td class="code"><pre><span class="line"><span class="comment">#拆分通道</span></span><br><span class="line"><span class="keyword">import</span> cv2</span><br><span class="line">img = cv2.imread(<span class="string">&#x27;img\Oucer-Jinsheng.jpg&#x27;</span>,<span class="number">1</span>)</span><br><span class="line">cv2.imshow(<span class="string">&quot;person&quot;</span>,img)</span><br><span class="line">b,g,r = cv2.split(img)</span><br><span class="line">cv2.imshow(<span class="string">&quot;B&quot;</span>,b)</span><br><span class="line">cv2.imshow(<span class="string">&quot;G&quot;</span>,g)</span><br><span class="line">cv2.imshow(<span class="string">&quot;R&quot;</span>,r)</span><br><span class="line"></span><br><span class="line">hsv_img = cv2.cvtColor(img,cv2.COLOR_HSV2BGR)</span><br><span class="line">h,s,v = cv2.split(img)</span><br><span class="line">cv2.imshow(<span class="string">&quot;H&quot;</span>,h )</span><br><span class="line">cv2.imshow(<span class="string">&quot;S&quot;</span>,s)</span><br><span class="line">cv2.imshow(<span class="string">&quot;V&quot;</span>,v)</span><br><span class="line"></span><br><span class="line"><span class="comment">#合并B通道图像、G通道图像、R通道图像 </span></span><br><span class="line"><span class="keyword">import</span> cv2</span><br><span class="line">img = cv2.imread(<span class="string">&#x27;img\Oucer-Jinsheng.jpg&#x27;</span>,<span class="number">1</span>)</span><br><span class="line"><span class="comment"># cv2.imshow(&quot;person&quot;,img)</span></span><br><span class="line">b,g,r = cv2.split(img)</span><br><span class="line">rgb = cv2.merge([r,g,b])    <span class="comment">#按RGB的顺序合并通道</span></span><br><span class="line">cv2.imshow(<span class="string">&quot;RGB&quot;</span>,rgb)</span><br><span class="line"></span><br><span class="line">bgr = cv2.merge([b,g,r])    <span class="comment">#按BGR的顺序合并通道</span></span><br><span class="line">cv2.imshow(<span class="string">&quot;BGR&quot;</span>,bgr)</span><br><span class="line"></span><br><span class="line">hsv_img = cv2.cvtColor(img,cv2.COLOR_BGR2HSV)</span><br><span class="line">h,s,v = cv2.split(hsv_img)</span><br><span class="line">hsv = cv2.merge([h,s,v])</span><br><span class="line">cv2.imshow(<span class="string">&quot;HSV&quot;</span>,hsv)</span><br><span class="line">cv2.waitKey()</span><br><span class="line">cv2.destroyAllWindows</span><br></pre></td></tr></table></figure>]]></content>
      
      
